// Prisma schema for Neon PostgreSQL — Kouky Beauty LMS
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum PriceType {
  paid
  free
}

enum OrderStatus {
  pending
  done
  cancelled
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  phone        String     @unique
  email        String?    @unique
  whatsapp     String
  wilaya       String
  passwordHash String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  enrollments         Enrollment[]
  courseOrders        CourseOrder[]
  certificateOrders   CertificateOrder[]
  lessonProgress      LessonProgress[]

  @@map("users")
}

model Course {
  id             String      @id
  slug           String      @unique
  title          String
  description    String      @default("")
  thumbnail      String      @default("")
  category       String      @default("عام")
  level          CourseLevel @default(beginner)
  durationHours  Int         @default(0)
  durationMinutes Int        @default(0)
  priceType      PriceType   @default(paid)
  price          Int         @default(4500)
  promoPrice     Int?
  archived       Boolean     @default(false)
  previewVideoId String?
  benefits       String[]    @default([])
  targetAudience String[]    @default([])
  materials      String[]    @default([])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  modules           Module[]
  enrollments       Enrollment[]
  courseOrders      CourseOrder[]
  certificateOrders CertificateOrder[]
  lessonProgress    LessonProgress[]

  @@map("courses")
}

model Module {
  id       String @id
  courseId String
  title    String
  order    Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id          String  @id
  moduleId    String
  title       String
  description String  @default("")
  order       Int
  videoId     String?
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model CourseOrder {
  id          String      @id @default(cuid())
  userId      String
  courseId    String
  courseTitle String
  amount      Int
  status      OrderStatus @default(pending)
  note        String?
  createdAt   DateTime    @default(now())
  completedAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("course_orders")
}

model CertificateOrder {
  id          String      @id @default(cuid())
  userId      String
  courseId    String
  courseTitle String
  status      OrderStatus @default(pending)
  createdAt   DateTime    @default(now())
  completedAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("certificate_orders")
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String
  completedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("lesson_progress")
}
